# Copy to terraform/.env (git-ignored, chmod 600) and fill in.
# Loaded by `make rebuild` / `make destroy`, only for Terraform.
# Single quotes keep the "!" of the token from being interpreted by the shell.
export PROXMOX_VE_ENDPOINT='https://<proxmox-host>:8006/'
export PROXMOX_VE_API_TOKEN='terraform@pve!provider=<secret>'
