# The real inventory (hosts.yml) is git-ignored: it holds the lab IPs and
# user name. Generate it from Terraform with `make inventory`, or copy this
# file to hosts.yml and adapt it. Placeholder values below.
all:
  vars:
    ansible_user: admin
  children:
    k3s_cluster:
      children:
        server:
          hosts:
            k3s-server-1:
              ansible_host: 10.0.0.11
        agent:
          hosts:
            k3s-agent-1:
              ansible_host: 10.0.0.21
